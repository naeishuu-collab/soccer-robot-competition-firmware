{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build MAIN",
      "type": "process",
      "command": "${env:LOCALAPPDATA}\\Programs\\Arduino IDE\\resources\\app\\lib\\backend\\resources\\arduino-cli.exe",
      "args": [
        "compile",
        "--clean",
        "--export-binaries",
        "--fqbn",
        "rp2040:rp2040:generic_rp2350:variantchip=RP2350B",
        "${workspaceFolder}\\main"
      ],
      "problemMatcher": []
    },
    {
      "label": "Build IR",
      "type": "process",
      "command": "${env:LOCALAPPDATA}\\Programs\\Arduino IDE\\resources\\app\\lib\\backend\\resources\\arduino-cli.exe",
      "args": [
        "compile",
        "--clean",
        "--export-binaries",
        "--fqbn",
        "rp2040:rp2040:generic_rp2350:variantchip=RP2350A",
        "${workspaceFolder}\\ir"
      ],
      "problemMatcher": []
    },
    {
      "label": "Build LINE",
      "type": "process",
      "command": "${env:LOCALAPPDATA}\\Programs\\Arduino IDE\\resources\\app\\lib\\backend\\resources\\arduino-cli.exe",
      "args": [
        "compile",
        "--clean",
        "--export-binaries",
        "--fqbn",
        "rp2040:rp2040:generic_rp2350:variantchip=RP2350B",
        "${workspaceFolder}\\line"
      ],
      "problemMatcher": []
    },
    {
      "label": "Build MOTOR",
      "type": "process",
      "command": "${env:LOCALAPPDATA}\\Programs\\Arduino IDE\\resources\\app\\lib\\backend\\resources\\arduino-cli.exe",
      "args": [
        "compile",
        "--clean",
        "--export-binaries",
        "--fqbn",
        "rp2040:rp2040:generic_rp2350:variantchip=RP2350A",
        "${workspaceFolder}\\motor"
      ],
      "problemMatcher": []
    },
    {
      "label": "Build ALL",
      "dependsOn": [
        "Build MAIN",
        "Build IR",
        "Build LINE",
        "Build MOTOR"
      ],
      "dependsOrder": "sequence",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Upload MAIN",
      "type": "process",
      "command": "${env:LOCALAPPDATA}\\Programs\\Arduino IDE\\resources\\app\\lib\\backend\\resources\\arduino-cli.exe",
      "args": [
        "upload",
        "--fqbn",
        "rp2040:rp2040:generic_rp2350:variantchip=RP2350B",
        "--port",
        "${input:uploadPort}",
        "${workspaceFolder}\\main"
      ],
      "problemMatcher": []
    },
    {
      "label": "Upload IR",
      "type": "process",
      "command": "${env:LOCALAPPDATA}\\Programs\\Arduino IDE\\resources\\app\\lib\\backend\\resources\\arduino-cli.exe",
      "args": [
        "upload",
        "--fqbn",
        "rp2040:rp2040:generic_rp2350:variantchip=RP2350A",
        "--port",
        "${input:uploadPort}",
        "${workspaceFolder}\\ir"
      ],
      "problemMatcher": []
    },
    {
      "label": "Upload LINE",
      "type": "process",
      "command": "${env:LOCALAPPDATA}\\Programs\\Arduino IDE\\resources\\app\\lib\\backend\\resources\\arduino-cli.exe",
      "args": [
        "upload",
        "--fqbn",
        "rp2040:rp2040:generic_rp2350:variantchip=RP2350B",
        "--port",
        "${input:uploadPort}",
        "${workspaceFolder}\\line"
      ],
      "problemMatcher": []
    },
    {
      "label": "Upload MOTOR",
      "type": "process",
      "command": "${env:LOCALAPPDATA}\\Programs\\Arduino IDE\\resources\\app\\lib\\backend\\resources\\arduino-cli.exe",
      "args": [
        "upload",
        "--fqbn",
        "rp2040:rp2040:generic_rp2350:variantchip=RP2350A",
        "--port",
        "${input:uploadPort}",
        "${workspaceFolder}\\motor"
      ],
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "uploadPort",
      "type": "promptString",
      "description": "書き込み先のCOMポートを入力してください（例：COM5）"
    }
  ]
}
