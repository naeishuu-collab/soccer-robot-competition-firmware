          "rp2040:rp2040:generic_rp2350:variantchip=RP2350B,flash=2097152_0",
          "${workspaceFolder:04 LINE - 現在未使用}"
        ],
        "problemMatcher": [
          "$gcc"
        ]
      },
      {
        "label": "コンパイル: ４基板すべて",
        "dependsOn": [
          "コンパイル: MAIN (RP2350B)",
          "コンパイル: IR (RP2350A)",
          "コンパイル: MOTOR (RP2350A)",
          "コンパイル: LINE (RP2350B)"
        ],
        "dependsOrder": "sequence",
        "group": {
          "kind": "build",
          "isDefault": true
        },
        "problemMatcher": []
      }
    ]
  }
