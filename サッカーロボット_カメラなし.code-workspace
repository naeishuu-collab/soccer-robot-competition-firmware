          "--fqbn",
          "rp2040:rp2040:generic_rp2350:variantchip=RP2350B,flash=2097152_0",
          "${workspaceFolder:01 MAIN - 司令}"
        ],
        "problemMatcher": [
          "$gcc"
        ]
      },
      {
        "label": "コンパイル: IR (RP2350A)",
        "type": "process",
        "command": "arduino-cli",
        "args": [
          "compile",
          "--fqbn",
          "rp2040:rp2040:generic_rp2350:variantchip=RP2350A,flash=2097152_0",
          "${workspaceFolder:02 IR - ボール検出}"
        ],
        "problemMatcher": [
          "$gcc"
        ]
      },
      {
        "label": "コンパイル: MOTOR (RP2350A)",
        "type": "process",
        "command": "arduino-cli",
        "args": [
          "compile",
          "--fqbn",
          "rp2040:rp2040:generic_rp2350:variantchip=RP2350A,flash=2097152_0",
          "${workspaceFolder:03 MOTOR - 駆動}"
        ],
        "problemMatcher": [
          "$gcc"
        ]
      },
      {
        "label": "コンパイル: LINE (RP2350B)",
