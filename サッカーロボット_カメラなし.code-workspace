{
  "folders": [
    {
      "path": "soccer_ir_main_motor",
      "name": "サッカーロボット（MAIN・IR・MOTORのみ）"
    }
  ],
  "settings": {
    "files.exclude": {
      "**/build": true,
      "**/__pycache__": true,
      "**/*.pyc": true,
      "**/line": true,
      "**/tests": true,
      "**/common": true,
      "**/config": true
    },
    "search.exclude": {
      "**/build": true,
      "**/__pycache__": true,
      "**/*.pyc": true,
      "**/line": true,
      "**/tests": true,
      "**/common": true,
      "**/config": true
    }
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "コンパイル: MAIN (RP2350B)",
        "type": "process",
        "command": "arduino-cli",
        "args": [
          "compile",
          "--fqbn",
          "rp2040:rp2040:generic_rp2350:variantchip=RP2350B,flash=2097152_0",
          "${workspaceFolder}/main"
        ],
        "problemMatcher": ["$gcc"]
      },
      {
        "label": "コンパイル: IR (RP2350A)",
        "type": "process",
        "command": "arduino-cli",
        "args": [
          "compile",
          "--fqbn",
          "rp2040:rp2040:generic_rp2350:variantchip=RP2350A,flash=2097152_0",
          "${workspaceFolder}/ir"
        ],
        "problemMatcher": ["$gcc"]
      },
      {
        "label": "コンパイル: MOTOR (RP2350A)",
        "type": "process",
        "command": "arduino-cli",
        "args": [
          "compile",
          "--fqbn",
          "rp2040:rp2040:generic_rp2350:variantchip=RP2350A,flash=2097152_0",
          "${workspaceFolder}/motor"
        ],
        "problemMatcher": ["$gcc"]
      },
      {
        "label": "コンパイル: 3基板 (MAIN + IR + MOTOR)",
        "dependsOn": [
          "コンパイル: MAIN (RP2350B)",
          "コンパイル: IR (RP2350A)",
          "コンパイル: MOTOR (RP2350A)"
        ],
        "dependsOrder": "sequence",
        "group": {
          "kind": "build",
          "isDefault": true
        },
        "problemMatcher": []
      }
    ]
  }
}
